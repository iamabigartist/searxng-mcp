# Optional: URL of your self-hosted SearXNG instance.
# When set, searches prefer this instance and fall back to ranked public instances on request failure.
# Leave unset to use ranked public-instance fallback from searx.space directly.
# SEARXNG_URL=https://searx.example.com

# Optional: set to false to disable public fallback and require SEARXNG_URL.
# USE_RANDOM_INSTANCE=true

# Optional: Basic authentication credentials
# SEARXNG_USERNAME=your_username
# SEARXNG_PASSWORD=your_password
